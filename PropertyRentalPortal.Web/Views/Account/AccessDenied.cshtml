@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card shadow border-0 p-5">
            <i class="bi bi-shield-slash-fill text-danger display-1 mb-3"></i>
            <h2 class="fw-bold mb-2">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have the required permissions to access this resource. Please switch to the appropriate role (Property Manager or Applicant) using the demo switch above.
            </p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 me-2">Return Home</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4">Sign In</a>
            </div>
        </div>
    </div>
</div>
