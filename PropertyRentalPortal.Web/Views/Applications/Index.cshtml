@using PropertyRentalPortal.Web.Models
@using PropertyRentalPortal.Web.Data.Enums
@model ApplicationListViewModel
@{
    ViewData["Title"] = Model.IsPropertyManager ? "Rental Applications" : "My Applications";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-file-earmark-ruled text-primary me-2"></i>@(Model.IsPropertyManager ? "Rental Applications Management" : "My Rental Applications")
        </h2>
        <p class="text-muted small mb-0">
            @(Model.IsPropertyManager 
                ? "Review, track, and process incoming rental applications across all properties" 
                : "Track the status of your applications, make revisions, or submit drafts")
        </p>
    </div>

    @if (!Model.IsPropertyManager)
    {
        <a asp-controller="Properties" asp-action="AvailableUnits" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>New Application
        </a>
    }
</div>

<!-- Database Filter Bar -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Filter by Property</label>
                <select name="propertyId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Properties</option>
                    @foreach (var p in Model.Properties)
                    {
                        <option value="@p.Value" selected="@p.Selected">@p.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Filter by Status</label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (ApplicationStatus s in Enum.GetValues(typeof(ApplicationStatus)))
                    {
                        <option value="@((int)s)" selected="@(Model.Filter.Status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Page Size</label>
                <select name="pageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="5" selected="@(Model.Filter.PageSize == 5)">5 per page</option>
                    <option value="10" selected="@(Model.Filter.PageSize == 10)">10 per page</option>
                    <option value="25" selected="@(Model.Filter.PageSize == 25)">25 per page</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-x-circle me-1"></i>Reset Filters
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Reusable Grid View Component -->
@await Component.InvokeAsync("ReusableGrid", Model)
