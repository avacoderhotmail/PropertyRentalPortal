@using PropertyRentalPortal.Web.Data.Entities
@model List<Unit>
@{
    var properties = (List<Property>)ViewData["Properties"]!;
    var selectedPropertyId = (int?)ViewData["SelectedPropertyId"];
    ViewData["Title"] = "Available Apartments";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-houses text-primary me-2"></i>Browse Available Apartments
        </h2>
        <p class="text-muted small mb-0">Find your next home and start a rental application today</p>
    </div>

    <!-- Filter by Property -->
    <form method="get" class="d-flex align-items-center gap-2">
        <label class="form-label small text-muted mb-0 fw-semibold text-nowrap">Filter Community:</label>
        <select name="propertyId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Properties (@properties.Count)</option>
            @foreach (var p in properties)
            {
                <option value="@p.Id" selected="@(selectedPropertyId == p.Id)">@p.Name</option>
            }
        </select>
    </form>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center text-muted">
        <i class="bi bi-house-slash fs-1 d-block mb-3 text-secondary"></i>
        <h5>No available units found</h5>
        <p class="small text-muted mb-0">There are currently no unoccupied units available for lease matching your selection.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var unit in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100 d-flex flex-column">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-1">@unit.UnitType?.Name</span>
                            <h5 class="fw-bold text-dark mb-0">@unit.Property.Name</h5>
                            <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@unit.Property.City, @unit.Property.State</small>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success">
                            Available Now
                        </span>
                    </div>

                    <div class="card-body flex-grow-1">
                        <div class="d-flex justify-content-between align-items-baseline mb-3">
                            <span class="fs-4 fw-bold text-dark">Unit @unit.UnitNumber</span>
                            <div class="text-end">
                                <span class="fs-4 fw-bold text-success">$@unit.MonthlyRent.ToString("N0")</span>
                                <span class="text-muted small">/mo</span>
                            </div>
                        </div>

                        <div class="row g-2 text-center bg-light p-2 rounded-3 border mb-3">
                            <div class="col-6">
                                <small class="text-muted d-block" style="font-size: 11px;">BEDROOMS</small>
                                <span class="fw-bold">@(unit.Bedrooms == 0 ? "Studio" : $"{unit.Bedrooms} Bed")</span>
                            </div>
                            <div class="col-6 border-start">
                                <small class="text-muted d-block" style="font-size: 11px;">BATHROOMS</small>
                                <span class="fw-bold">@unit.Bathrooms Bath</span>
                            </div>
                        </div>

                        <p class="text-secondary small mb-0">
                            Includes 12-month standard lease term upon application approval.
                        </p>
                    </div>

                    <div class="card-footer bg-white border-top py-3 text-end">
                        <form asp-controller="Applications" asp-action="Start" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="unitId" value="@unit.Id" />
                            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                                <i class="bi bi-file-earmark-plus me-1"></i>Apply for this Apartment
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
