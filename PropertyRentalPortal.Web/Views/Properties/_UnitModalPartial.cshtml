@using PropertyRentalPortal.Web.Models
@model UnitFormViewModel

<div class="modal-header bg-light">
    <h5 class="modal-title fw-bold text-primary">
        <i class="bi bi-door-open me-2"></i>@(Model.Id == 0 ? $"Add Unit to {Model.PropertyName}" : $"Edit Unit {Model.UnitNumber}")
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="unit-modal-form" asp-controller="Properties" asp-action="@(Model.Id == 0 ? "CreateUnit" : "EditUnit")" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PropertyId" />
    <input type="hidden" asp-for="PropertyName" />

    <div class="modal-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="UnitNumber" class="form-label fw-semibold"></label>
                <input asp-for="UnitNumber" class="form-control" placeholder="e.g. 101, 204B, PH-1" />
                <span asp-validation-for="UnitNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="UnitTypeId" class="form-label fw-semibold"></label>
                <select asp-for="UnitTypeId" asp-items="Model.AvailableUnitTypes" class="form-select">
                    <option value="">-- Select Unit Type --</option>
                </select>
                <span asp-validation-for="UnitTypeId" class="text-danger small"></span>
                <small class="text-muted d-block mt-1">Inactive unit types cannot be assigned to other units.</small>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Bedrooms" class="form-label fw-semibold"></label>
                <input asp-for="Bedrooms" type="number" min="0" max="10" class="form-control" />
                <span asp-validation-for="Bedrooms" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Bathrooms" class="form-label fw-semibold"></label>
                <input asp-for="Bathrooms" type="number" step="0.5" min="0.5" max="10" class="form-control" />
                <span asp-validation-for="Bathrooms" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="MonthlyRent" class="form-label fw-semibold"></label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="MonthlyRent" type="number" step="0.01" min="100" class="form-control" placeholder="1850.00" />
            </div>
            <span asp-validation-for="MonthlyRent" class="text-danger small"></span>
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary px-4 fw-semibold">
            <i class="bi bi-check2 me-1"></i>Save Unit
        </button>
    </div>
</form>
