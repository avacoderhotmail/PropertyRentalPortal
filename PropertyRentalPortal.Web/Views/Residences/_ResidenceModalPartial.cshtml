@using PropertyRentalPortal.Web.Models
@model ResidenceHistoryInputModel

<div class="modal-header bg-light">
    <h5 class="modal-title fw-bold text-primary">
        <i class="bi bi-house-door me-2"></i>@(Model.Id == 0 ? "Add Prior Residence" : "Edit Prior Residence")
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="residence-modal-form" asp-controller="Residences" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RentalApplicationId" />

    <div class="modal-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label fw-semibold"></label>
            <input asp-for="Address" class="form-control" placeholder="e.g. 520 Elm Street, Apt 3B" />
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-6">
                <label asp-for="City" class="form-label fw-semibold"></label>
                <input asp-for="City" class="form-control" placeholder="City" />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="State" class="form-label fw-semibold"></label>
                <input asp-for="State" class="form-control" placeholder="State" />
                <span asp-validation-for="State" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ZipCode" class="form-label fw-semibold"></label>
                <input asp-for="ZipCode" class="form-control" placeholder="Zip" />
                <span asp-validation-for="ZipCode" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-6">
                <label asp-for="LandlordName" class="form-label fw-semibold"></label>
                <input asp-for="LandlordName" class="form-control" placeholder="Landlord or Property Manager Name" />
                <span asp-validation-for="LandlordName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LandlordPhone" class="form-label fw-semibold"></label>
                <input asp-for="LandlordPhone" class="form-control" placeholder="(555) 000-0000" />
                <span asp-validation-for="LandlordPhone" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-md-6">
                <label asp-for="MoveInDate" class="form-label fw-semibold"></label>
                <input asp-for="MoveInDate" type="date" class="form-control" />
                <span asp-validation-for="MoveInDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MoveOutDate" class="form-label fw-semibold"></label>
                <input asp-for="MoveOutDate" type="date" class="form-control" />
                <span asp-validation-for="MoveOutDate" class="text-danger small"></span>
                <small class="text-muted d-block mt-1">Leave empty if currently living here</small>
            </div>
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary px-4 fw-semibold">
            <i class="bi bi-check2 me-1"></i>Save Residence
        </button>
    </div>
</form>
